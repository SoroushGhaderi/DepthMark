# Environment Variables - Sensitive & Environment-Specific Data Only
# Application configuration is in config.yaml
# See config.yaml for all application settings
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. DO NOT commit .env to git
# 4. This file (.env.example) can be committed as a reference
#
# This file should ONLY contain:
# - Database credentials
# - API tokens and authentication
# - Telegram bot credentials
# - Bronze S3 sync credentials
# - Environment-specific overrides

# ============================================================================
# DEPTHMARK RUNTIME ENVIRONMENT
# ============================================================================

# scripts/bootstrap.sh creates .env from this file, generates the database
# passwords, and sets DEPTHMARK_ENV (production on servers, local with --local).
# Compose has no password defaults. Outside local development, setup rejects
# empty, placeholder, or known local-dev database credentials.
DEPTHMARK_ENV=local

# Host address that Compose publishes the ClickHouse and MongoDB ports on.
# 127.0.0.1 keeps them reachable from this machine only. Use 0.0.0.0 only on a
# trusted private network.
DEPTHMARK_BIND_ADDRESS=127.0.0.1

# UID of the host user that owns data/ and logs/; the scraper image runs as it.
# scripts/bootstrap.sh sets this automatically.
DEPTHMARK_UID=1000

# ============================================================================
# CLICKHOUSE DATABASE CONFIGURATION (Environment-specific)
# ============================================================================

CLICKHOUSE_HOST=depthmark-clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=fotmob_user
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
# Maintenance identity (ADR 0029): runs setup, full-history loads, and
# maintenance commands. The ClickHouse container creates this user; setup then
# creates CLICKHOUSE_USER above with read/insert/partition-replace rights only.
CLICKHOUSE_MAINTENANCE_USER=depthmark_admin
CLICKHOUSE_MAINTENANCE_PASSWORD=your_clickhouse_maintenance_password_here
CLICKHOUSE_DB_FOTMOB=fotmob
CLICKHOUSE_DB_GOLD=gold
CLICKHOUSE_DB_GOLD_SCENARIOS=gold_scenarios
CLICKHOUSE_DB_GOLD_SIGNALS=gold_signals

# ============================================================================
# MONGODB CONTENT CATALOG CONFIGURATION
# ============================================================================

MONGODB_HOST=depthmark-mongodb
MONGODB_PORT=27017
MONGODB_USER=orbit_admin
MONGODB_PASSWORD=your_mongodb_password_here
MONGODB_DATABASE=orbit_content
MONGODB_AUTH_SOURCE=admin
# Optional full URI override (takes precedence in app code if used)
MONGODB_URI=mongodb://orbit_admin:your_mongodb_password_here@depthmark-mongodb:27017/orbit_content?authSource=admin

# ============================================================================
# FOTMOB SCRAPER - CONFIGURATION
# ============================================================================

# FotMob browser cookies live in credentials.json at the repo root (ignored by
# git, mounted read-only into the container). credentials.json.example shows its
# shape. scripts/bootstrap.sh creates an empty one, scripts/refresh_turnstile.py
# refreshes the turnstile_verified cookie, and the scraper re-reads the file on
# every request. Set FOTMOB_X_MAS_TOKEN in this file.

# ============================================================================
# FOTMOB BROWSER & PROXY SETTINGS (Optional)
# ============================================================================

# Enable browser automation (for Cloudflare/Turnstile handling)
# Set to true if API scraping fails with 403 errors
FOTMOB_BROWSER_ENABLED=false

# Enable proxy (useful for IP-based rate limiting)
FOTMOB_PROXY_ENABLED=false

# Proxy settings
FOTMOB_PROXY_HTTP=http://your-proxy-host:8080
FOTMOB_PROXY_HTTPS=http://your-proxy-host:8080

# ============================================================================
# ODDSPEDIA BROWSER SETTINGS (Optional)
# ============================================================================

# Set these only when Chrome/Chromium or its driver is not discoverable by the
# runtime. CHROME_BIN and CHROMEDRIVER_PATH are accepted compatibility aliases.
# ODDSPEDIA_CHROME_BIN=/usr/bin/chromium
# ODDSPEDIA_CHROMEDRIVER_PATH=/usr/bin/chromedriver

# ============================================================================
# TELEGRAM BOT - Daily Metrics & Alerts
# ============================================================================

# Get your bot token from @BotFather on Telegram
# Format: bot_token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your chat ID:
# 1. Send a message to your bot
# 2. Visit https://api.telegram.org/bot[TOKEN]/getUpdates
# 3. Find your chat_id in the response
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# EMAIL ALERTING - Optional (Legacy)
# ============================================================================

# Optional: Configure email alerts (if TELEGRAM_BOT_TOKEN is not available)
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=your_email@gmail.com
# ALERT_SMTP_PASSWORD='your_app_specific_password_here'
# ALERT_FROM_EMAIL=your_email@gmail.com
# ALERT_TO_EMAILS=your_email@gmail.com

# ============================================================================
# BRONZE S3 SYNC CONFIGURATION (Optional outside sync commands)
# ============================================================================

# S3-compatible storage for independently synchronized Bronze archives
# Works with AWS S3, Arvan Cloud, MinIO, etc.

# S3 Endpoint URL
# Arvan Cloud (Iran): https://bucket-name.s3.ir-tbz-sh1.arvanstorage.ir
# The sync command accepts a virtual-hosted endpoint and normalizes it to the
# provider endpoint before making virtual-hosted S3 requests. Set S3_BUCKET
# explicitly to avoid ambiguity.
# AWS S3: https://s3.region.amazonaws.com
# MinIO: http://localhost:9000
S3_ENDPOINT=https://your-bucket.s3.your-region.storage-provider.com

# S3 Access Key
S3_ACCESS_KEY=your_s3_access_key_here

# S3 Secret Key
S3_SECRET_KEY=your_s3_secret_key_here

# Explicit bucket name. It is inferred from virtual-hosted S3 endpoints when
# omitted (e.g. scout-sport.s3.ir-tbz-sh1.arvanstorage.ir).
# S3_BUCKET=scout-sport

# Optional S3 signing region. Defaults to the existing Arvan region for
# backward compatibility.
# S3_REGION=ir-tbz-sh1

# ============================================================================
# CONFIGURATION FILE PATHS
# ============================================================================

# Path to YAML configuration file (relative to workspace root)
CONFIG_FILE_PATH=config.yaml

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# FOTMOB SCRAPING:
# 1. FOTMOB_X_MAS_TOKEN
# 2. Cookies in credentials.json (see credentials.json.example)
#
# FOR CLICKHOUSE STORAGE:
# 1. All CLICKHOUSE_* variables
#
# FOR ALERTS:
# 1. TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID
#
# FOR STANDALONE BRONZE S3 SYNC:
# 1. S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY
# 2. S3_BUCKET when it cannot be inferred from S3_ENDPOINT
#
# ============================================================================
