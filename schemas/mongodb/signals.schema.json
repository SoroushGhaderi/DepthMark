{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit Signal",
  "description": "A signals document mirrored from a validated signal catalog by scripts/mongodb/sync_signal_catalogs.py (ADR 0033).",
  "type": "object",
  "required": [
    "signal_id",
    "status",
    "entity",
    "family",
    "subfamily",
    "grain",
    "headline",
    "trigger",
    "row_identity",
    "asset_paths",
    "assets",
    "frontmatter",
    "source_path",
    "markdown_body",
    "content_sha256",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "signal_id": {
      "type": "string",
      "pattern": "^sig_(match|team|player)_[a-z0-9]+_[a-z0-9]+_[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated"]
    },
    "entity": {
      "type": "string",
      "enum": ["match", "team", "player"]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "subfamily": {
      "type": "string",
      "minLength": 1
    },
    "grain": {
      "type": "string",
      "enum": ["match_team", "match_player"]
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "row_identity": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "asset_paths": {
      "type": "object",
      "required": ["table", "sql"],
      "properties": {
        "table": {
          "type": "string"
        },
        "sql": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["table", "sql"],
      "properties": {
        "table": {
          "type": "string"
        },
        "sql": {
          "type": "object",
          "required": ["path", "content", "sha256", "byte_count"],
          "properties": {
            "path": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": true
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "markdown_body": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
